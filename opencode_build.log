+// ==== BEGIN VARGA CORE ====
+function vargaBase(sid){
+  const L = norm360(sid);
+  const signIdx = Math.floor(L/30);
+  return {L, signIdx, degIn: L - signIdx*30};
+}
+function vargaPartOf(sid, nParts){
+  const b = vargaBase(sid);
+  const step = 30/nParts;
+  const part = Math.min(nParts-1, Math.floor(b.degIn/step));
+  return {signIdx:b.signIdx, degIn:b.degIn, part};
+}
+function vargaStepped(sid, nParts, startFn, stride){
+  const vp = vargaPartOf(sid, nParts);
+  return (((startFn(vp.signIdx) + vp.part*stride) % 12) + 12) % 12;
+}
+const vIsOddSign = si => si % 2 === 0;   // Aries = index 0 = 1st sign = odd
+const vModality  = si => si % 3;         // 0 movable, 1 fixed, 2 dual
+const vElement   = si => si % 4;         // 0 fire, 1 earth, 2 air, 3 water
