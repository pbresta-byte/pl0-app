+/* =========================================================================
+   VARGA READING TEMPLATES (Parashara's-Light-style divisional readings)
+   Purely template-generated synthesis for the selected varga — one line per
+   planet per house placement in the division, theme sentence varying by the
+   varga's stated purpose (BPHS Ṣoḍaśavarga chapter purposes). Clearly marked
+   as "template reading" at render time; this app is a synthesis tool, not
+   scripture. Reuses the existing dignityTier() and SIGN_SANSKRIT.
+   ========================================================================= */
+const VARGA_READING_THEME = {
+  D1:{en:"body and life as a whole",es:"el cuerpo y la vida en conjunto"},
+  D2:{en:"wealth",es:"la riqueza"},
+  D3:{en:"siblings",es:"los hermanos"},
+  D4:{en:"property and fortune",es:"la propiedad y la fortuna"},
+  D7:{en:"progeny",es:"la progenie"},
+  D9:{en:"spouse and dharma",es:"el cónyuge y el dharma"},
+  D10:{en:"career and public power",es:"la carrera y el poder público"},
+  D12:{en:"parents",es:"los padres"},
+  D16:{en:"vehicles and comforts",es:"los vehículos y las comodidades"},
+  D20:{en:"spiritual pursuits",es:"las búsquedas espirituales"},
+  D24:{en:"education and learning",es:"la educación y el aprendizaje"},
+  D27:{en:"innate strengths and weaknesses",es:"las fortalezas y debilidades innatas"},
+  D30:{en:"misfortunes and evils",es:"las desgracias y los maleficios"},
+  D40:{en:"maternal legacy",es:"el legado materno"},
+  D45:{en:"paternal legacy",es:"el legado paterno"},
+  D60:{en:"karma of past deeds",es:"el karma de actos pasados"}
+};
+const DIGNITY_TAIL = {
+  "Exalted":   {en:"unusually strong here (exalted)",es:"inusualmente fuerte aquí (exaltado)"},
+  "Own":       {en:"strong in its own sign",es:"fuerte en su propio signo"},
+  "Own (per source note)": {en:"strong in its own sign (per source note)",es:"fuerte en su propio signo (según nota de la fuente)"},
+  "Friend":    {en:"well supported (friend's sign)",es:"bien apoyado (signo de amigo)"},
+  "Neutral":   {en:"neutral in this division",es:"neutral en esta división"},
+  "Enemy":     {en:"strained here (enemy sign)",es:"tenso aquí (signo enemigo)"},
+  "Debilitated":{en:"weakened here (debilitated) — effort over grace",es:"debilitado aquí (debilitado) — esfuerzo más que gracia"},
+  "—":         {en:"",es:""}
+};
+function dignityTagClass(tier){
+  if (["Exalted","Own","Own (per source note)"].includes(tier)) return "good";
+  if (["Debilitated","Enemy"].includes(tier)) return "bad";
+  return "neutral";
+}
+// One template paragraph: graha G sits in divisional sign vSignIdx, counted
+// as house H from that varga's Lagna (lagnaVIdx). Theme varies by varga.
+function vargaPlanetReadingLine(def, g, vSignIdx, lagnaVIdx){
+  if (!Number.isInteger(vSignIdx)) return "";
+  const signName = SIGNS[vSignIdx];
+  const sans = SIGN_SANSKRIT[signName] || "";
+  const house = ((vSignIdx - lagnaVIdx + 12) % 12) + 1;
+  const tier = dignityTier(g, vSignIdx*30); // reuse the engine's own dignity ladder on a synthetic whole-sign longitude
+  const tail = DIGNITY_TAIL[tier] || {en:"",es:""};
+  const theme = VARGA_READING_THEME[def.key] || {en:def.purpose.en, es:def.purpose.es};
+  const en = `${g} in ${sans} (${signName}), the ${ordinalSuffix(house)} of ${def.name}, suggests its ${theme.en} significations act through ${HOUSE_SIGNIF[house].en}${tail.en?` — ${tail.en}`:''}.`;
+  const es = `${T(g,GRAHA_ES[g])} en ${sans} (${signName}), la ${house}ª de ${def.name}, sugiere que sus significaciones de ${theme.es} actúan a través de ${HOUSE_SIGNIF[house].es}${tail.es?` — ${tail.es}`:''}.`;
+  return `<div style="margin-bottom:10px;">
+    <b style="color:${MALEFIC_GRAHAS.includes(g)?'var(--vermilion)':'var(--jade)'};">${gNameNatal(g)}</b>
+    <span style="color:var(--ink-dim);">→ ${signName} · ${sans}</span>
+    <span class="tag ${dignityTagClass(tier)}" title="${T('Dignity in this division','Dignidad en esta división')}">${tier===''?'—':tier}</span>
+    <div class="hint" style="margin-top:2px;"><small style="color:var(--gold);">${T('template reading','lectura plantilla')}:</small> ${T(en,es)}</div>
+  </div>`;
+}
+// D1-only lordship readings: for each house H, where its lord sits and one
+// combined sentence from the existing LORD_CARRIES / PLACE_DELIVERS tables.
+function d1LordshipReadingsHtml(vargaTable, ascIdx){
+  let out = `<h3 style="margin:14px 0 8px; font-size:12px; letter-spacing:0.03em; color:var(--gold); text-transform:uppercase;">${T('D1 lordship readings','Lecturas de señorío D1')}</h3>`;
+  for (let H=1; H<=12; H++){
+    const hSign = SIGNS[(ascIdx + H - 1) % 12];
+    const lord = SIGN_LORD[hSign];
+    const lordHouseIdx = vargaTable[lord] ? vargaTable[lord].D1 : null;
+    if (!Number.isInteger(lordHouseIdx)) continue;
+    const Y = ((lordHouseIdx - ascIdx + 12) % 12) + 1;
+    const carries = LORD_CARRIES[H], delivers = PLACE_DELIVERS[Y];
+    out += `<div class="hint" style="margin-top:2px;"><small style="color:var(--gold);">${T('template reading','lectura plantilla')}:</small> ${T(
+      `Lord of ${H}${ordinalSuffix(H)} (${lord}) sits in house ${Y} — ${carries[0]} flow toward ${delivers[0]}.`,
+      `El señor de la casa ${H} (${T(lord,GRAHA_ES[lord])}) está en la casa ${Y} — ${carries[1]} fluyen hacia ${delivers[1]}.`)}</div>`;
+  }
+  return out;
+}
