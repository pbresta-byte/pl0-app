+/* End-times of the running Tithi / Nakshatra / Yoga / Karana ("day-to-day
+   timings" as printed in a pañcāṅga). Linear-motion approximation: each limb
+   advances at its own rate, so remaining fraction × span ÷ speed gives the
+   hours left. Tithi & Yoga & Karana move at the Moon-Sun relative speed;
+   the Nakshatra at the Moon's own speed. Returns local "HH:MM" wall-clock
+   strings plus "(in Xh Ym)" remaining, per limb, derived from the jd/pos
+   passed in (same moment computePanchanga() was called on). */
+function panchangaEndTimes(jd, pos){
+  if (!pos || !pos.Moon || !pos.Sun || !isFinite(jd)) return null;
+  const p = computePanchanga(pos);
+  if (!p || !isFinite(p.tithiRawFrac)) return null;
+  const relativeSpeed = pos.Moon.speed - pos.Sun.speed; // deg/day, typically ~12-15
+  if (!isFinite(relativeSpeed) || relativeSpeed <= 0) return null;
+
+  const tithiEndOffsetDays  = ((Math.ceil(p.tithiRawFrac) - p.tithiRawFrac) * 12) / relativeSpeed;
+  const nakEndOffsetDays    = ((Math.ceil(p.nakRawFrac)   - p.nakRawFrac) * (360/27)) / pos.Moon.speed;
+  const yogaEndOffsetDays   = ((Math.ceil(p.yogaRawFrac)  - p.yogaRawFrac) * (40/3)) / relativeSpeed;
+  // Karana = half a tithi → boundary every 6° of relative motion
+  const karanaEndOffsetDays = ((Math.ceil(p.tithiRawFrac*2) - p.tithiRawFrac*2) * 6) / relativeSpeed;
+
+  const baseMs = (jd - 2440587.5) * 86400000; // JD (UT) -> Unix ms
+  function fmt(offsetDays){
+    const end = new Date(baseMs + offsetDays*24*3600*1000);
+    const hhmm = `${pad2(end.getHours())}:${pad2(end.getMinutes())}`;
+    const remMin = Math.max(0, Math.round(offsetDays*24*60));
+    const h = Math.floor(remMin/60), m = remMin%60;
+    return { isoLocal: `${end.getFullYear()}-${pad2(end.getMonth()+1)}-${pad2(end.getDate())}T${hhmm}`,
+             hhmm,
+             remaining: `(${T('in','en')} ${h}h ${m}m)` };
+  }
+  return { relativeSpeed,
+           tithi:     fmt(tithiEndOffsetDays),
+           nakshatra: fmt(nakEndOffsetDays),
+           yoga:      fmt(yogaEndOffsetDays),
+           karana:    fmt(karanaEndOffsetDays) };
+}
+
